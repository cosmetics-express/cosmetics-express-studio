# Explicitly choose demo or production. Production never falls back to demo.
APP_MODE=demo
APP_URL=http://localhost:3000
# Production: run supabase/migrations/001_studio.sql, then configure:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Platform-owned key, only read by the server. Never NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
